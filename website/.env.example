# LeetGPU Website 环境变量示例
# 复制此文件为 .env 并根据需要修改

# Flask 配置
FLASK_ENV=production
FLASK_APP=app.py
FLASK_DEBUG=0

# 服务器配置
HOST=0.0.0.0
PORT=5000

# Python 配置
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# 应用配置
APP_NAME=LeetGPU
APP_VERSION=1.0.0

# 可选：数据库配置（未来扩展）
# DATABASE_URL=sqlite:///leetgpu.db

# 可选：Redis 配置（未来扩展）
# REDIS_URL=redis://localhost:6379/0

# 可选：日志配置
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/leetgpu/app.log
