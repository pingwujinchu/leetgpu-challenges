# LeetGPU Online Testing Website - Production Dockerfile
# 多阶段构建，优化镜像大小

# 阶段1: 构建阶段
FROM python:3.11-slim as builder

WORKDIR /build

# 安装构建依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 创建虚拟环境并安装依赖
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# 阶段2: 运行阶段
FROM python:3.11-slim

# 设置标签
LABEL maintainer="LeetGPU Team" \
      version="1.0" \
      description="LeetGPU Online Testing Website" \
      org.opencontainers.image.source="https://github.com/leetgpu" \
      org.opencontainers.image.title="LeetGPU Website" \
      org.opencontainers.image.description="GPU Programming Online Testing Platform"

# 创建非root用户
RUN groupadd -r leetgpu && \
    useradd -r -g leetgpu -u 1000 leetgpu && \
    mkdir -p /app && \
    chown -R leetgpu:leetgpu /app

WORKDIR /app

# 从构建阶段复制虚拟环境
COPY --from=builder /opt/venv /opt/venv

# 设置环境变量
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FLASK_APP=app.py \
    FLASK_ENV=production

# 复制应用文件
COPY --chown=leetgpu:leetgpu . .

# 切换到非root用户
USER leetgpu

# 生成题目元数据
RUN python generate_challenge_metadata.py || echo "Metadata will be generated at runtime"

# 暴露端口
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/stats').read()" || exit 1

# 启动应用
CMD ["python", "app.py"]
